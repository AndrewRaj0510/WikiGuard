# Runs the latency benchmark with the serving install only, under Render's limits:
#   docker build -f jobs/trainer/Dockerfile.benchmark -t wikiguard-benchmark .
#   docker run --rm --cpus=0.1 --memory=512m -v "$PWD/data/runs:/runs" \
#     wikiguard-benchmark /runs/mlp/model --rows /runs/benchmarks/sample.json --label render-limits
# A measuring tool run by hand, never deployed, so it installs from version ranges and not a lock.
FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
WORKDIR /app
COPY packages/wikiguard_core packages/wikiguard_core
RUN pip install --no-cache-dir "./packages/wikiguard_core[serve,archive]"
COPY jobs/trainer/trainer/__init__.py jobs/trainer/trainer/benchmark.py trainer/
RUN useradd --create-home benchmark
USER benchmark
ENTRYPOINT ["python", "-m", "trainer.benchmark"]
