{
  "uid": "wikiguard-api",
  "title": "WikiGuard / API",
  "description": "What the API on Render records in Postgres. Its /metrics isn't scraped, because each scrape would keep the free service awake (F-015).",
  "tags": [
    "wikiguard"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Where the rest is",
      "options": {
        "mode": "markdown",
        "content": "Per-route latency and error rates are on the API's own `/metrics`, which needs a bearer token and isn't scraped from here: a scrape every few minutes would keep Render's free service awake around the clock and use up the 750 shared hours (F-015). The load tests in Phase 8 read it directly. Render's dashboard shows requests and memory too."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Sign-ins per hour, by kind",
      "description": "From the audit log: guest and user sign-ins, sign-outs, and failures.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('hour', at) AS time, action || ' ' || actor AS metric, count(*) AS value FROM audit_log WHERE $__timeFilter(at) AND action LIKE 'auth.%' GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
