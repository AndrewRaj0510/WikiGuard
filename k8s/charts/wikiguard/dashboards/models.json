    {
      "type": "timeseries",
      "title": "Shadow candidate",
      "description": "During a 24-hour shadow period, the candidate scores live edits with no effect on users (section 4).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(scorer_shadow_scored_total[15m])) * 60",
