    {
      "type": "timeseries",
      "title": "Alias reload failures, per hour",
      "description": "A failed reload keeps the old model serving. Repeated failures need a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
