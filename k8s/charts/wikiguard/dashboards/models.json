      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT id, trigger, status, started_at, finished_at FROM retrain_runs ORDER BY id DESC LIMIT 10",
