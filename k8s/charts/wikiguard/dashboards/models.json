    {
      "type": "timeseries",
      "title": "Batch latency, p95, by model",
      "description": "Per micro-batch: Kafka read, features, model, and the Postgres write.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
