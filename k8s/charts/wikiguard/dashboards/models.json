    {
      "type": "table",
      "title": "Serving versions",
      "description": "What the registry says serves, as the trainer last recorded it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_name AS model, model_version AS version, alias, registered_at FROM model_versions WHERE alias IS NOT NULL ORDER BY alias",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "options": {
