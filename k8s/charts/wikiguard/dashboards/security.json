    {
      "type": "stat",
      "title": "Failed sign-ins, 24 h",
      "description": "Wrong password for the user account. Lockout starts after a few in a row.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) FROM audit_log WHERE action = 'auth.sign_in_failed' AND at > now() - interval '24 hours'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
