    {
      "type": "timeseries",
      "title": "Failed sign-ins and denied actions per 15 min",
      "description": "A spike is someone trying passwords or calling user-only routes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(at, '15m'), action AS metric, count(*) AS value FROM audit_log WHERE $__timeFilter(at) AND action IN ('auth.sign_in_failed', 'auth.denied') GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest admin and gate actions",
      "description": "The audit log is append-only for every runtime role (section 8).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT at, actor, action, target FROM audit_log WHERE action LIKE 'admin.%' OR action LIKE 'gate.%' ORDER BY id DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
