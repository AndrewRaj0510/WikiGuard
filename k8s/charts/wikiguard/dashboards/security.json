    {
      "type": "timeseries",
      "title": "Container restarts per hour",
      "description": "A crash loop can be an attack on the parser, or a bad deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"wikiguard\"}[1h]))",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
