{
  "uid": "wikiguard-security",
  "title": "WikiGuard / Security",
  "description": "Section 8's detect-and-respond signals: failed sign-ins, denied actions, admin use, LLM spend, and the cluster's own health.",
  "tags": [
    "wikiguard"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
