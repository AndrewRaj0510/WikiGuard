    {
      "type": "stat",
      "title": "LLM calls today",
      "description": "Against the daily cap (EXPLAIN_DAILY_CALL_CAP). Alerts at 50% and 80%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wikiguard-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT coalesce(sum(calls), 0) FROM llm_usage WHERE day = current_date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wikiguard-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
