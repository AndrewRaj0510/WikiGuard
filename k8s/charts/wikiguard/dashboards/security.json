    {
      "type": "timeseries",
      "title": "Pods not ready",
      "description": "A running pod failing its readiness probe. Anything above zero for long is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (kube_pod_status_ready{namespace=\"wikiguard\",condition=\"false\"} * on (namespace, pod) kube_pod_status_phase{namespace=\"wikiguard\",phase=\"Running\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
