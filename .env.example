# Every setting WikiGuard reads. Copy to .env and fill in the blanks. Never commit .env.
# Blank means no default: a service that needs the value refuses to start without it.
# Values shown are the defaults. A test keeps this file in step with config.py.

# --- Local Docker Compose only ---
POSTGRES_USER=wikiguard
POSTGRES_PASSWORD=
POSTGRES_DB=wikiguard
POSTGRES_PORT=5433

# --- Common ---
# dev, staging, or prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database (Supabase) ---
# Prod and staging use these same two names with different values, because each place the app
# runs reads only its own settings:
#   This .env on the laptop      staging project (or local Compose). Never prod.
#   Staging Render and cluster   staging project
#   Prod Render and cluster      prod project
# These are read from where the app runs. Nothing gets added inside Supabase.
#
# WikiGuard only talks to Postgres, so don't add the project URL or the anon or service_role keys.
# Copy each string from the Connect panel in the Supabase dashboard, because the pooler host
# can't be worked out from the region. Percent-encode any special characters in the password.
#
# What a service uses: Transaction pooler, port 6543. README.md lists the login for each service.
# A custom login's username is LOGIN.PROJECT-REF. Leave blank until that login exists.
#   postgresql://LOGIN.PROJECT-REF:PASSWORD@POOLER-HOST:6543/postgres?sslmode=require
# Local Compose instead (not localhost, which tried IPv6 first and hung):
#   postgresql://USER:PASSWORD@127.0.0.1:5433/wikiguard
DATABASE_URL=
# What only the migration job uses, because it can change the schema: Session pooler, port 5432,
# which holds one session and works over IPv4. The direct connection is IPv6-only on the free plan.
#   postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
DATABASE_MIGRATIONS_URL=

# --- Redpanda (Kafka API) ---
# Containers use redpanda:9092. Code on the laptop uses 127.0.0.1:19092.
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Wikimedia ---
# Required by Wikimedia policy: a descriptive name and a contact URL.
WIKIMEDIA_USER_AGENT=
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
MEDIAWIKI_API_URL=https://en.wikipedia.org/w/api.php

# --- Privacy ---
# HMAC-SHA-256 key for user_hash, at least 32 characters.
USER_HASH_KEY=

# --- MLflow on DagsHub ---
# URI: https://dagshub.com/AndrewRaj0510/WikiGuard.mlflow. Username: the DagsHub username. Password: an access token.
# DVC doesn't read this file. Its token goes in .dvc/config.local (see README.md).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Serving ---
# Emergency override, for example mlp. Blank uses the registry aliases.
FORCE_MODEL=
# 300 in the cluster. 5000 on Render: RoBERTa's slowest edit took 4.3 s at 0.1 CPU and 512 MB (DEC-050).
PREDICT_TIMEOUT_MS=300

# --- API ---
# At least 32 characters.
SESSION_SECRET_KEY=
# Argon2id hash of the user password, never the password itself.
USER_PASSWORD_HASH=
# Bearer token for /metrics on Render.
METRICS_BEARER_TOKEN=
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Feature flags ---
EXPLAIN_ENABLED=true
PREDICT_ENABLED=true
READ_ONLY_MODE=false
GATE_ENABLED=true

# --- Single-seat gate ---
GUEST_IDLE_MINUTES=5
GUEST_MAX_MINUTES=15
GATE_HEARTBEAT_SECONDS=15
GATE_LEASE_SECONDS=45
GUEST_EXPLAIN_LIMIT=5

# --- LLM for Explain ---
LLM_MODEL=
LLM_BACKUP_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Set below the provider's free quota.
EXPLAIN_DAILY_CALL_CAP=

# --- Retraining ---
# 1, 7, or 14
RETRAIN_INTERVAL_DAYS=7
RETRAIN_ON_DRIFT=true
RETRAIN_STARTUP_DELAY_SECONDS=300

# --- Workers ---
# Port for /health and /metrics.
OPS_PORT=8000
# Where the ingestor keeps its stream position.
INGEST_STATE_PATH=data/ingestor_state.json

# --- Parquet archive ---
# A local folder until Phase 7, then Oracle Object Storage through its S3-compatible API.
ARCHIVE_PATH=data/archive
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=

# --- Alerts and error tracking (optional) ---
SENTRY_DSN=
DISCORD_WEBHOOK_URL=
HEALTHCHECKS_PING_URL=
