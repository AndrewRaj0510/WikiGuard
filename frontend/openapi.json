              {
                "type": "null"
              }
            ],
            "title": "Alias"
          },
          "forced": {
            "title": "Forced",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "load_shed": {
            "title": "Load Shed",
            "type": "boolean"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "scored_at": {
            "format": "date-time",
            "title": "Scored At",
            "type": "string"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          },
          "used_fallback": {
            "title": "Used Fallback",
            "type": "boolean"
          }
        },
        "required": [
          "model_name",
          "model_version",
          "alias",
          "score",
          "threshold",
          "used_fallback",
          "load_shed",
          "forced",
          "latency_ms",
          "scored_at"
        ],
        "title": "ScoreInfo",
        "type": "object"
      },
      "SessionInfo": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fresh_explains_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fresh Explains Left"
          },
          "role": {
            "enum": [
              "guest",
              "user"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "UserSignIn": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "tab_id": {
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "title": "Tab Id",
            "type": "string"
          },
          "take_over": {
            "default": false,
            "title": "Take Over",
            "type": "boolean"
          }
        },
        "required": [
          "password",
          "tab_id"
        ],
        "title": "UserSignIn",
        "type": "object"
      }
    }
  },
